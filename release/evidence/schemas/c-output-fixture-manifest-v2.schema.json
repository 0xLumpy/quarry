{
  "$id": "urn:quarry:schema:c-output-fixture-manifest:v2",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Quarry frozen C-OUTPUT fixture manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["cases", "helper", "schema_version"],
  "properties": {
    "schema_version": {"const": "quarry.c-output-fixture-manifest.v2"},
    "helper": {"$ref": "#/$defs/helper"},
    "cases": {
      "type": "array", "minItems": 9, "maxItems": 9, "items": false,
      "prefixItems": [
        {"$ref": "#/$defs/empty"},
        {"$ref": "#/$defs/non_empty"},
        {"$ref": "#/$defs/malformed"},
        {"$ref": "#/$defs/truncated"},
        {"$ref": "#/$defs/non_utf8"},
        {"$ref": "#/$defs/partial"},
        {"$ref": "#/$defs/timeout"},
        {"$ref": "#/$defs/signal"},
        {"$ref": "#/$defs/tool_specific_exit"}
      ]
    }
  },
  "$defs": {
    "bare_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "safe_path": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\)[^\\u0000-\\u001f]+$"},
    "candidate_input": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,127}$"},
    "fixture": {
      "type": "object", "additionalProperties": false,
      "required": ["bytes", "candidate_input", "encoding", "path", "sha256", "source_bytes", "source_sha256"],
      "properties": {
        "bytes": {"type": "integer", "minimum": 0, "maximum": 16777216},
        "candidate_input": {"$ref": "#/$defs/candidate_input"},
        "encoding": {"enum": ["raw", "hex"]},
        "path": {"$ref": "#/$defs/safe_path"},
        "sha256": {"$ref": "#/$defs/bare_digest"},
        "source_bytes": {"type": "integer", "minimum": 0, "maximum": 16777216},
        "source_sha256": {"$ref": "#/$defs/bare_digest"}
      }
    },
    "parser": {
      "type": "object", "additionalProperties": false,
      "required": ["complete", "outcome", "records"],
      "properties": {
        "complete": {"type": "boolean"},
        "outcome": {"enum": ["empty", "non_empty", "malformed", "truncated", "non_utf8", "unavailable"]},
        "records": {"type": ["integer", "null"], "minimum": 0, "maximum": 16777216}
      }
    },
    "expected": {
      "type": "object", "additionalProperties": false,
      "required": ["effective_status", "execution_terminal", "exit", "native", "parser", "repository_publication", "stderr_terminal", "stdout_terminal"],
      "properties": {
        "effective_status": {"enum": ["success", "empty", "partial", "failed", "timed_out"]},
        "execution_terminal": {"enum": ["complete", "timed_out"]},
        "exit": {"enum": ["zero", "one", "negative", "none"]},
        "native": {"enum": ["none", "committed"]},
        "parser": {"$ref": "#/$defs/parser"},
        "repository_publication": {"enum": ["published", "fenced"]},
        "stderr_terminal": {"enum": ["eof", "deadline"]},
        "stdout_terminal": {"enum": ["eof", "capped", "deadline"]}
      }
    },
    "helper": {
      "type": "object", "additionalProperties": false,
      "required": ["candidate_input", "path", "sha256"],
      "properties": {
        "candidate_input": {"const": "c-output-python-helper"},
        "path": {"const": "tests/helpers/c_output_fixture.py"},
        "sha256": {"$ref": "#/$defs/bare_digest"}
      }
    },
    "case": {
      "type": "object", "additionalProperties": false,
      "required": ["executor", "expected", "fixture", "id", "stderr"],
      "properties": {
        "executor": {"enum": ["candidate-python-helper", "gitleaks"]},
        "expected": {"$ref": "#/$defs/expected"},
        "fixture": {"oneOf": [{"$ref": "#/$defs/fixture"}, {"type": "null"}]},
        "id": {"type": "string", "maxLength": 32},
        "stderr": {"oneOf": [{"$ref": "#/$defs/fixture"}, {"type": "null"}]}
      }
    },
    "empty": {"allOf": [{"$ref": "#/$defs/case"}, {"properties": {"executor": {"const": "candidate-python-helper"}, "id": {"const": "empty"}, "fixture": {"$ref": "#/$defs/fixture"}, "stderr": {"type": "null"}, "expected": {"const": {"effective_status": "empty", "execution_terminal": "complete", "exit": "zero", "native": "none", "parser": {"complete": true, "outcome": "empty", "records": 0}, "repository_publication": "published", "stderr_terminal": "eof", "stdout_terminal": "eof"}}}}]},
    "non_empty": {"allOf": [{"$ref": "#/$defs/case"}, {"properties": {"executor": {"const": "gitleaks"}, "id": {"const": "non_empty"}, "fixture": {"$ref": "#/$defs/fixture"}, "stderr": {"type": "null"}, "expected": {"const": {"effective_status": "success", "execution_terminal": "complete", "exit": "one", "native": "committed", "parser": {"complete": true, "outcome": "non_empty", "records": 1}, "repository_publication": "published", "stderr_terminal": "eof", "stdout_terminal": "eof"}}}}]},
    "malformed": {"allOf": [{"$ref": "#/$defs/case"}, {"properties": {"executor": {"const": "candidate-python-helper"}, "id": {"const": "malformed"}, "fixture": {"$ref": "#/$defs/fixture"}, "stderr": {"type": "null"}, "expected": {"const": {"effective_status": "partial", "execution_terminal": "complete", "exit": "zero", "native": "none", "parser": {"complete": false, "outcome": "malformed", "records": null}, "repository_publication": "published", "stderr_terminal": "eof", "stdout_terminal": "eof"}}}}]},
    "truncated": {"allOf": [{"$ref": "#/$defs/case"}, {"properties": {"executor": {"const": "candidate-python-helper"}, "id": {"const": "truncated"}, "fixture": {"$ref": "#/$defs/fixture"}, "stderr": {"type": "null"}, "expected": {"const": {"effective_status": "partial", "execution_terminal": "complete", "exit": "zero", "native": "none", "parser": {"complete": false, "outcome": "truncated", "records": null}, "repository_publication": "fenced", "stderr_terminal": "eof", "stdout_terminal": "capped"}}}}]},
    "non_utf8": {"allOf": [{"$ref": "#/$defs/case"}, {"properties": {"executor": {"const": "candidate-python-helper"}, "id": {"const": "non_utf8"}, "fixture": {"$ref": "#/$defs/fixture"}, "stderr": {"type": "null"}, "expected": {"const": {"effective_status": "partial", "execution_terminal": "complete", "exit": "zero", "native": "none", "parser": {"complete": false, "outcome": "non_utf8", "records": null}, "repository_publication": "published", "stderr_terminal": "eof", "stdout_terminal": "eof"}}}}]},
    "partial": {"allOf": [{"$ref": "#/$defs/case"}, {"properties": {"executor": {"const": "candidate-python-helper"}, "id": {"const": "partial"}, "fixture": {"$ref": "#/$defs/fixture"}, "stderr": {"$ref": "#/$defs/fixture"}, "expected": {"const": {"effective_status": "partial", "execution_terminal": "complete", "exit": "zero", "native": "none", "parser": {"complete": true, "outcome": "empty", "records": 0}, "repository_publication": "published", "stderr_terminal": "eof", "stdout_terminal": "eof"}}}}]},
    "timeout": {"allOf": [{"$ref": "#/$defs/case"}, {"properties": {"executor": {"const": "candidate-python-helper"}, "id": {"const": "timeout"}, "fixture": {"type": "null"}, "stderr": {"type": "null"}, "expected": {"const": {"effective_status": "timed_out", "execution_terminal": "timed_out", "exit": "none", "native": "none", "parser": {"complete": false, "outcome": "unavailable", "records": null}, "repository_publication": "fenced", "stderr_terminal": "deadline", "stdout_terminal": "deadline"}}}}]},
    "signal": {"allOf": [{"$ref": "#/$defs/case"}, {"properties": {"executor": {"const": "candidate-python-helper"}, "id": {"const": "signal"}, "fixture": {"type": "null"}, "stderr": {"type": "null"}, "expected": {"const": {"effective_status": "failed", "execution_terminal": "complete", "exit": "negative", "native": "none", "parser": {"complete": false, "outcome": "unavailable", "records": null}, "repository_publication": "published", "stderr_terminal": "eof", "stdout_terminal": "eof"}}}}]},
    "tool_specific_exit": {"allOf": [{"$ref": "#/$defs/case"}, {"properties": {"executor": {"const": "gitleaks"}, "id": {"const": "tool_specific_exit"}, "fixture": {"$ref": "#/$defs/fixture"}, "stderr": {"type": "null"}, "expected": {"const": {"effective_status": "success", "execution_terminal": "complete", "exit": "one", "native": "committed", "parser": {"complete": true, "outcome": "non_empty", "records": 1}, "repository_publication": "published", "stderr_terminal": "eof", "stdout_terminal": "eof"}}}}]}
  }
}
