{
  "$id": "urn:quarry:schema:candidate-identity:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "$defs": {
    "digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "git_object": {
      "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$",
      "type": "string"
    },
    "path": {
      "minLength": 1,
      "type": "string"
    },
    "token": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
      "type": "string"
    }
  },
  "properties": {
    "dirty": {
      "const": false
    },
    "git_commit": {
      "$ref": "#/$defs/git_object"
    },
    "git_tree": {
      "$ref": "#/$defs/git_object"
    },
    "inputs": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "digest": {
            "$ref": "#/$defs/digest"
          },
          "name": {
            "$ref": "#/$defs/token"
          },
          "path": {
            "$ref": "#/$defs/path"
          }
        },
        "required": [
          "digest",
          "name",
          "path"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "package_version": {
      "minLength": 1,
      "type": "string"
    },
    "package_version_sources": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "digest": {
            "$ref": "#/$defs/digest"
          },
          "path": {
            "$ref": "#/$defs/path"
          },
          "value": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "digest",
          "path",
          "value"
        ],
        "type": "object"
      },
      "maxItems": 2,
      "minItems": 2,
      "type": "array"
    },
    "release": {
      "const": "0.3.10"
    },
    "schema_version": {
      "const": "quarry.candidate-identity.v1"
    },
    "schema_versions": {
      "additionalProperties": false,
      "properties": {
        "candidate_identity": {
          "const": "quarry.candidate-identity.v1"
        },
        "gate_record": {
          "const": "quarry.release-gate.v1"
        },
        "schema_registry": {
          "const": "quarry.release-schema-registry.v1"
        }
      },
      "required": [
        "candidate_identity",
        "gate_record",
        "schema_registry"
      ],
      "type": "object"
    },
    "source_tree_digest": {
      "$ref": "#/$defs/digest"
    },
    "source_tree_digest_algorithm": {
      "const": "quarry.git-tree-sha256.v1"
    },
    "submodules": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "git_commit": {
            "$ref": "#/$defs/git_object"
          },
          "path": {
            "$ref": "#/$defs/path"
          }
        },
        "required": [
          "git_commit",
          "path"
        ],
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": [
    "dirty",
    "git_commit",
    "git_tree",
    "inputs",
    "package_version",
    "package_version_sources",
    "release",
    "schema_version",
    "schema_versions",
    "source_tree_digest",
    "source_tree_digest_algorithm",
    "submodules"
  ],
  "title": "Quarry release candidate identity v1",
  "type": "object"
}
