      "required": ["attempts", "environment", "evidence_instance_id", "isolation_profile"],
      "type": "object"
    },
    "h0_isolation_self_test": {
      "additionalProperties": false,
      "properties": {"artifact_type": {"const": "h0-isolation-self-test"}, "candidate_identity_digest": {"$ref": "#/$defs/digest"}, "gate_id": {"const": "B-HERMETIC-ALL"}, "instances": {"items": {"$ref": "#/$defs/h0_isolation_instance"}, "maxItems": 2, "minItems": 2, "type": "array"}, "name": {"const": "isolation-self-test"}, "release": {"const": "0.3.10"}, "schema_version": {"const": "quarry.gate-artifact.v1"}},
      "required": ["artifact_type", "candidate_identity_digest", "gate_id", "instances", "name", "release", "schema_version"],
      "type": "object"
    },
    "h0_fragment": {
      "additionalProperties": false,
      "properties": {"digest": {"$ref": "#/$defs/digest"}, "job_instance_id": {"pattern": "^\\.github/workflows/ci\\.yml#jobs\\.offline\\[python-version=3\\.(10|12),shard=[0-5]\\]$", "type": "string"}, "report": {"$ref": "#/$defs/h0_shard_report"}},
      "required": ["digest", "job_instance_id", "report"],
      "type": "object"
    },
    "h0_collector": {
      "additionalProperties": false,
      "properties": {"name": {"const": "pytest"}, "python_implementation": {"$ref": "#/$defs/token"}, "python_version": {"$ref": "#/$defs/text"}, "version": {"$ref": "#/$defs/text"}},
      "required": ["name", "python_implementation", "python_version", "version"],
