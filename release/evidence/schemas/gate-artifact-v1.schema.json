    "clean_build_log": {
      "additionalProperties": false,
      "properties": {"artifact_type": {"const": "clean-build-log"}, "candidate_identity_digest": {"$ref": "#/$defs/digest"}, "clean_tree": {"const": true}, "command": {"const": ["python", "-m", "build", "--sdist", "--wheel", "--outdir", "dist"]}, "combined_output": {"$ref": "#/$defs/build_output"}, "exit_code": {"const": 0}, "gate_id": {"const": "C-PACKAGE-BUILD"}, "package": {"$ref": "#/$defs/package"}, "release": {"const": "0.3.10"}, "schema_version": {"const": "quarry.gate-artifact.v1"}, "subjects": {"items": {"$ref": "#/$defs/package_subject"}, "maxItems": 2, "minItems": 2, "type": "array", "uniqueItems": true}},
      "required": ["artifact_type", "candidate_identity_digest", "clean_tree", "command", "combined_output", "exit_code", "gate_id", "package", "release", "schema_version", "subjects"],
