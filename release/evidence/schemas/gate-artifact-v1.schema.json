    "docs_policy_parity_report": {
      "additionalProperties": false,
      "properties": {"artifact_type": {"const": "docs-policy-parity-report"}, "candidate_identity_digest": {"$ref": "#/$defs/digest"}, "docs_policy_materials": {"items": {"$ref": "#/$defs/docs_policy_material"}, "minItems": 20, "maxItems": 20, "type": "array", "uniqueItems": true}, "environment": {"$ref": "#/$defs/environment"}, "evidence_finished_at": {"$ref": "#/$defs/text"}, "evidence_instance_id": {"$ref": "#/$defs/token"}, "evidence_started_at": {"$ref": "#/$defs/text"}, "gate_id": {"const": "B-DOCS-POLICY"}, "name": {"const": "docs-policy-parity"}, "release": {"const": "0.3.10"}, "schema_version": {"const": "quarry.gate-artifact.v1"}, "selection": {"$ref": "#/$defs/docs_policy_selection"}, "test_results": {"items": {"$ref": "#/$defs/docs_policy_test_result"}, "minItems": 13, "maxItems": 13, "type": "array"}, "test_source_digest": {"$ref": "#/$defs/digest"}},
      "required": ["artifact_type", "candidate_identity_digest", "docs_policy_materials", "environment", "evidence_finished_at", "evidence_instance_id", "evidence_started_at", "gate_id", "name", "release", "schema_version", "selection", "test_results", "test_source_digest"],
