          "required": ["artifact_kind", "expected", "id", "lane", "operation"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "artifact_kind": {"const": "mode-owner-symlink-matrix"},
            "expected": {"const": "refused"},
            "id": {"const": "h1-directory-symlink-refusal"},
            "lane": {"const": "H1-tool-integration"},
            "operation": {"const": "directory_symlink"}
          },
          "required": ["artifact_kind", "expected", "id", "lane", "operation"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "artifact_kind": {"const": "mode-owner-symlink-matrix"},
            "expected": {"const": "refused"},
            "id": {"const": "h1-file-symlink-refusal"},
            "lane": {"const": "H1-tool-integration"},
            "operation": {"const": "file_symlink"}
          },
          "required": ["artifact_kind", "expected", "id", "lane", "operation"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "artifact_kind": {"const": "mode-owner-symlink-matrix"},
            "expected": {"const": "refused"},
            "id": {"const": "h1-foreign-owner-refusal"},
            "lane": {"const": "H1-tool-integration"},
            "operation": {"const": "foreign_owner"}
