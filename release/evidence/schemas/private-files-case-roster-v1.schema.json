            "id": {"const": "h0-create-directory-umask"},
            "lane": {"const": "H0-hermetic"},
            "operation": {"const": "create_directory"}
          },
          "required": ["artifact_kind", "expected", "id", "lane", "operation"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "artifact_kind": {"const": "filesystem-trace"},
            "expected": {"const": "created"},
            "id": {"const": "h0-create-file-umask"},
            "lane": {"const": "H0-hermetic"},
            "operation": {"const": "create_file"}
          },
          "required": ["artifact_kind", "expected", "id", "lane", "operation"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "artifact_kind": {"const": "filesystem-trace"},
            "expected": {"const": "refused"},
            "id": {"const": "h0-existing-mode-refusal"},
            "lane": {"const": "H0-hermetic"},
            "operation": {"const": "existing_unsafe_mode"}
