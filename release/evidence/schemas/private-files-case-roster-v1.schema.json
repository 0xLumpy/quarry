          "required": ["artifact_kind", "expected", "id", "lane", "operation"],
          "type": "object"
        }
      ],
      "type": "array"
    },
    "gate_id": {"const": "C-PRIVATE-FILES"},
    "release": {"const": "0.3.10"},
    "schema_version": {"const": "quarry.private-files-case-roster.v1"}
  },
  "required": ["cases", "gate_id", "release", "schema_version"],
  "title": "Quarry C-PRIVATE-FILES frozen operation roster v1",
  "type": "object"
}
