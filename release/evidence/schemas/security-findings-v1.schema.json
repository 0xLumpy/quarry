{
  "$id": "urn:quarry:schema:security-findings:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Quarry B-STATIC-SECURITY candidate-bound findings v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_type", "ast_inventory", "bindings", "candidate_identity_digest", "checks", "dependency_manifest", "detect_secrets_baseline_digest", "environment", "evidence_finished_at", "evidence_instance_id", "evidence_started_at", "findings", "gate_id", "h0_fragment_digest", "h0_property_tests", "job_instance_id", "name", "policy_digest", "release", "scan_fragment_digest", "schema_version", "selection", "suppressions", "toolchain", "unsuppressed_findings"],
  "properties": {
    "artifact_type": {"const": "security-findings"}, "candidate_identity_digest": {"$ref": "#/$defs/digest"}, "gate_id": {"const": "B-STATIC-SECURITY"}, "name": {"const": "security-findings"}, "release": {"const": "0.3.10"}, "schema_version": {"const": "quarry.security-findings.v1"},
    "ast_inventory": {"items": {"$ref": "#/$defs/finding"}, "minItems": 1, "type": "array", "uniqueItems": true}, "bindings": {"items": {"$ref": "#/$defs/binding"}, "minItems": 12, "maxItems": 12, "type": "array"}, "dependency_manifest": {"$ref": "#/$defs/binding"}, "detect_secrets_baseline_digest": {"$ref": "#/$defs/digest"}, "environment": {"$ref": "#/$defs/environment"}, "evidence_finished_at": {"type": "string"}, "evidence_instance_id": {"pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$", "type": "string"}, "evidence_started_at": {"type": "string"}, "findings": {"items": {"$ref": "#/$defs/finding"}, "type": "array", "uniqueItems": true}, "h0_fragment_digest": {"$ref": "#/$defs/digest"}, "h0_property_tests": {"$ref": "#/$defs/properties"}, "job_instance_id": {"const": ".github/workflows/ci.yml#jobs.offline[python-version=3.12,shard=0]"}, "policy_digest": {"$ref": "#/$defs/digest"}, "scan_fragment_digest": {"$ref": "#/$defs/digest"}, "selection": {"$ref": "#/$defs/selection"}, "checks": {"prefixItems": [{"allOf": [{"$ref": "#/$defs/check"}, {"properties": {"id": {"const": "bandit"}}}]}, {"allOf": [{"$ref": "#/$defs/check"}, {"properties": {"id": {"const": "detect-secrets"}}}]}, {"allOf": [{"$ref": "#/$defs/check"}, {"properties": {"id": {"const": "unsafe-api-inventory"}}}]}, {"allOf": [{"$ref": "#/$defs/check"}, {"properties": {"id": {"const": "h0-properties"}}}]}, {"allOf": [{"$ref": "#/$defs/check"}, {"properties": {"id": {"const": "dependency-manifest"}}}]}], "items": false, "minItems": 5, "maxItems": 5, "type": "array"}, "suppressions": {"items": {"$ref": "#/$defs/suppression"}, "type": "array", "uniqueItems": true}, "toolchain": {"items": {"$ref": "#/$defs/tool"}, "minItems": 3, "maxItems": 3, "type": "array", "uniqueItems": true}, "unsuppressed_findings": {"minimum": 0, "maximum": 9223372036854775807, "type": "integer"}
  },
  "$defs": {
    "digest": {"pattern": "^sha256:[0-9a-f]{64}$", "type": "string"},
    "binding": {"additionalProperties": false, "required": ["digest", "name", "path"], "properties": {"digest": {"$ref": "#/$defs/digest"}, "name": {"type": "string"}, "path": {"type": "string"}}, "type": "object"},
    "finding": {"additionalProperties": false, "required": ["api", "id", "line", "path", "source"], "properties": {"api": {"type": "string"}, "id": {"type": "string"}, "line": {"minimum": 1, "type": "integer"}, "path": {"type": "string"}, "source": {"type": "string"}}, "type": "object"},
    "suppression": {"additionalProperties": false, "required": ["expires_before", "finding_id", "id", "owner", "rationale"], "properties": {"expires_before": {"pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$", "type": "string"}, "finding_id": {"pattern": "^bandit-[0-9a-f]{20}$", "type": "string"}, "id": {"pattern": "^security-suppression-[0-9a-f]{20}$", "type": "string"}, "owner": {"minLength": 1, "type": "string"}, "rationale": {"minLength": 20, "type": "string"}}, "type": "object"},
    "environment": {"additionalProperties": false, "required": ["architecture", "isolation_profile", "os", "python", "runner_image"], "properties": {"architecture": {"type": "string"}, "isolation_profile": {"$ref": "#/$defs/digest"}, "os": {"type": "string"}, "python": {"type": "string"}, "runner_image": {"$ref": "#/$defs/digest"}}, "type": "object"},
    "tool": {"additionalProperties": false, "required": ["digest", "name", "path", "version"], "properties": {"digest": {"$ref": "#/$defs/digest"}, "name": {"type": "string"}, "path": {"type": "string"}, "version": {"type": "string"}}, "type": "object"},
    "properties": {"additionalProperties": false, "required": ["nodes", "sources"], "properties": {"nodes": {"items": {"type": "string"}, "minItems": 3, "maxItems": 3, "type": "array"}, "sources": {"items": {"type": "string"}, "minItems": 3, "maxItems": 3, "type": "array"}}, "type": "object"},
    "selection": {"additionalProperties": false, "required": ["collected", "deselected", "failed", "passed", "selected", "skipped", "xfailed", "xpassed"], "properties": {"collected": {"const": 5}, "deselected": {"const": 0}, "failed": {"const": 0}, "passed": {"const": 5}, "selected": {"const": 5}, "skipped": {"const": 0}, "xfailed": {"const": 0}, "xpassed": {"const": 0}}, "type": "object"},
    "check": {"additionalProperties": false, "required": ["id", "result_digest", "status"], "properties": {"id": {"enum": ["bandit", "detect-secrets", "unsafe-api-inventory", "h0-properties", "dependency-manifest"]}, "result_digest": {"$ref": "#/$defs/digest"}, "status": {"const": "pass"}}, "type": "object"}
  }
}
