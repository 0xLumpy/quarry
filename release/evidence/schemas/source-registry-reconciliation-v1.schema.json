{
  "$id": "urn:quarry:schema:source-registry-reconciliation:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Quarry C-SOURCE-REGISTRY reconciliation v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "artifact_type", "release", "gate_id", "name", "candidate_identity_digest", "input_bindings", "counts", "contracts", "doors", "local_event_without_transport", "h0_static_emitter", "h1_synthetic_admission"],
  "properties": {
    "schema_version": {"const": "quarry.source-registry-reconciliation.v1"}, "artifact_type": {"const": "source-registry-reconciliation"}, "release": {"const": "0.3.10"}, "gate_id": {"const": "C-SOURCE-REGISTRY"}, "name": {"const": "registry-reconciliation"},
    "candidate_identity_digest": {"$ref": "#/$defs/digest"},
    "input_bindings": {"type": "array", "items": {"$ref": "#/$defs/binding"}, "minItems": 9, "maxItems": 9},
    "counts": {"type": "object", "additionalProperties": false, "required": ["planned_contract_count", "auxiliary_contract_count", "canonical_contract_count", "planned_door_count", "auxiliary_door_count", "transport_door_count", "ownership_count"], "properties": {"planned_contract_count": {"const": 67}, "auxiliary_contract_count": {"const": 25}, "canonical_contract_count": {"const": 92}, "planned_door_count": {"const": 67}, "auxiliary_door_count": {"const": 24}, "transport_door_count": {"const": 91}, "ownership_count": {"const": 92}}},
    "contracts": {"type": "array", "items": {"$ref": "#/$defs/contract"}, "minItems": 92, "maxItems": 92},
    "doors": {"type": "array", "items": {"$ref": "#/$defs/door"}, "minItems": 91, "maxItems": 91},
    "local_event_without_transport": {"const": ["evidence.ownership"]}, "h0_static_emitter": {"$ref": "#/$defs/h0"}, "h1_synthetic_admission": {"$ref": "#/$defs/h1"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "text": {"type": "string", "minLength": 1, "maxLength": 4096},
    "binding": {"type": "object", "additionalProperties": false, "required": ["name", "path", "digest"], "properties": {"name": {"$ref": "#/$defs/text"}, "path": {"$ref": "#/$defs/text"}, "digest": {"$ref": "#/$defs/digest"}}},
    "transport": {"type": "object", "additionalProperties": false, "required": ["kind", "authority", "profile"], "properties": {"kind": {"$ref": "#/$defs/text"}, "authority": {"$ref": "#/$defs/text"}, "profile": {"$ref": "#/$defs/text"}}},
    "contract": {"type": "object", "additionalProperties": false, "required": ["section", "source_id", "tool", "phase", "tier", "class", "default", "input", "output", "workers", "rate", "timeout", "failure", "fallback", "parser", "log", "ownership", "transport"], "properties": {"section": {"enum": ["planned", "auxiliary"]}, "source_id": {"type": "string"}, "tool": {"type": "string"}, "phase": {"type": "string"}, "tier": {"type": "string"}, "class": {"type": "string"}, "default": {"type": "string"}, "input": {"type": "string"}, "output": {"type": "string"}, "workers": {"type": "string"}, "rate": {"type": "string"}, "timeout": {"type": "string"}, "failure": {"type": "string"}, "fallback": {"type": "string"}, "parser": {"type": "string"}, "log": {"type": "string"}, "reason": {"type": "string"}, "provider_control": {"type": "boolean"}, "ownership": {"type": "string"}, "transport": {"$ref": "#/$defs/transport"}}},
    "strings": {"type": "array", "items": {"$ref": "#/$defs/text"}, "uniqueItems": true, "maxItems": 256},
    "door": {"type": "object", "additionalProperties": false, "required": ["source_id", "kind", "authority", "profile", "argv0", "helpers", "descendants", "required_argv", "forbidden_argv", "connect_time_peer", "broker_required", "supported", "unsupported_reason"], "properties": {"source_id": {"type": "string"}, "kind": {"type": "string"}, "authority": {"type": "string"}, "profile": {"type": "string"}, "argv0": {"$ref": "#/$defs/strings"}, "helpers": {"$ref": "#/$defs/strings"}, "descendants": {"$ref": "#/$defs/strings"}, "required_argv": {"$ref": "#/$defs/strings"}, "forbidden_argv": {"$ref": "#/$defs/strings"}, "connect_time_peer": {"type": "boolean"}, "broker_required": {"type": "boolean"}, "supported": {"type": "boolean"}, "unsupported_reason": {"type": "string"}}},
    "emitter_file": {"type": "object", "additionalProperties": false, "required": ["path", "digest"], "properties": {"path": {"type": "string"}, "digest": {"$ref": "#/$defs/digest"}}},
    "helper_probe": {"type": "object", "additionalProperties": false, "required": ["kind", "value"], "properties": {"kind": {"const": "helper"}, "value": {"$ref": "#/$defs/text"}}},
    "argv_probe": {"type": "object", "additionalProperties": false, "required": ["kind", "value"], "properties": {"kind": {"const": "argv"}, "value": {"$ref": "#/$defs/strings"}}},
    "admission": {"type": "object", "additionalProperties": false, "required": ["door", "synthetic_probe", "admitted", "observed_door"], "properties": {"door": {"$ref": "#/$defs/door"}, "synthetic_probe": {"oneOf": [{"$ref": "#/$defs/helper_probe"}, {"$ref": "#/$defs/argv_probe"}]}, "admitted": {"type": "boolean"}, "observed_door": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/door"}]}}},
    "selection": {"type": "object", "additionalProperties": false, "required": ["collected", "deselected", "failed", "passed", "selected", "skipped", "xfailed", "xpassed"], "properties": {"collected": {"const": 1}, "deselected": {"const": 0}, "failed": {"const": 0}, "passed": {"const": 1}, "selected": {"const": 1}, "skipped": {"const": 0}, "xfailed": {"const": 0}, "xpassed": {"const": 0}}},
    "receipt": {"type": "object", "additionalProperties": false, "required": ["lane", "case_id", "nodeid", "evidence_instance_id", "selection", "result"], "properties": {"lane": {"enum": ["H0-hermetic", "H1-tool-integration"]}, "case_id": {"$ref": "#/$defs/text"}, "nodeid": {"$ref": "#/$defs/text"}, "evidence_instance_id": {"$ref": "#/$defs/text"}, "selection": {"$ref": "#/$defs/selection"}, "result": {"const": "pass"}}},
    "h0": {"type": "object", "additionalProperties": false, "required": ["partition", "executed_lane_count", "real_adapter_execution", "real_tool_execution", "provider_execution", "target_execution", "receipt", "discovery_roots", "discovery_files", "literal_source_ids", "finite_dynamic_maps"], "properties": {"partition": {"const": "H0-static-emitter"}, "executed_lane_count": {"const": 0}, "real_adapter_execution": {"const": false}, "real_tool_execution": {"const": false}, "provider_execution": {"const": false}, "target_execution": {"const": false}, "receipt": {"$ref": "#/$defs/receipt"}, "discovery_roots": {"type": "array", "items": {"$ref": "#/$defs/text"}, "minItems": 4, "maxItems": 4, "uniqueItems": true}, "discovery_files": {"type": "array", "items": {"$ref": "#/$defs/emitter_file"}, "minItems": 13, "maxItems": 13, "uniqueItems": true}, "literal_source_ids": {"$ref": "#/$defs/strings", "minItems": 32, "maxItems": 32}, "finite_dynamic_maps": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "object", "additionalProperties": false, "required": ["name", "source_ids"], "properties": {"name": {"$ref": "#/$defs/text"}, "source_ids": {"$ref": "#/$defs/strings"}}}}}},
    "h1": {"type": "object", "additionalProperties": false, "required": ["partition", "executed_lane_count", "real_adapter_execution", "real_tool_execution", "provider_execution", "target_execution", "receipt", "admissions"], "properties": {"partition": {"const": "H1-synthetic-transport-admission"}, "executed_lane_count": {"const": 0}, "real_adapter_execution": {"const": false}, "real_tool_execution": {"const": false}, "provider_execution": {"const": false}, "target_execution": {"const": false}, "receipt": {"$ref": "#/$defs/receipt"}, "admissions": {"type": "array", "items": {"$ref": "#/$defs/admission"}, "minItems": 91, "maxItems": 91}}}
  }
}
