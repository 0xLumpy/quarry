{
  "$id": "urn:quarry:schema:release-schema-registry:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "identity_inputs": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
            "type": "string"
          },
          "path": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "name",
          "path"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "release": {
      "const": "0.3.10"
    },
    "schema_version": {
      "const": "quarry.release-schema-registry.v1"
    },
    "schemas": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
            "type": "string"
          },
          "path": {
            "minLength": 1,
            "type": "string"
          },
          "record_version": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "name",
          "path",
          "record_version"
        ],
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": [
    "identity_inputs",
    "release",
    "schema_version",
    "schemas"
  ],
  "title": "Quarry release schema registry v1",
  "type": "object"
}
