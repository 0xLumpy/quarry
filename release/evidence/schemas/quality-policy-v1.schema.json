{
  "$id": "urn:quarry:schema:quality-policy:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Quarry B-QUALITY frozen policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["checks", "release", "schema_version"],
  "properties": {
    "schema_version": {"const": "quarry.quality-policy.v1"},
    "release": {"const": "0.3.10"},
    "checks": {
      "type": "array", "minItems": 6, "maxItems": 6, "items": false,
      "prefixItems": [
        {"$ref": "#/$defs/formatting"}, {"$ref": "#/$defs/lint"}, {"$ref": "#/$defs/type"},
        {"$ref": "#/$defs/docs"}, {"$ref": "#/$defs/dead_code"}, {"$ref": "#/$defs/complexity"}
      ]
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "text": {"type": "string", "minLength": 1},
    "check": {
      "type": "object", "additionalProperties": false,
      "required": ["argv", "budget", "config", "expected_exit_code", "id", "sources", "tool", "version"],
      "properties": {
        "id": {"enum": ["formatting", "lint", "type", "docs", "dead-code", "complexity"]},
        "argv": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/text"}},
        "tool": {"enum": ["ruff", "mypy", "pytest"]},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/text"}},
        "config": {"type": "object", "additionalProperties": false, "required": ["digest", "path"], "properties": {"digest": {"$ref": "#/$defs/digest"}, "path": {"$ref": "#/$defs/text"}}},
        "expected_exit_code": {"type": "integer", "minimum": 0, "maximum": 255},
        "budget": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807}
      }
    },
    "formatting": {"allOf": [{"$ref": "#/$defs/check"}, {"properties": {"id": {"const": "formatting"}, "argv": {"const": ["ruff", "format", "--check", "--output-format", "json", "src", "tests", "scripts"]}, "tool": {"const": "ruff"}, "version": {"const": "0.16.3"}, "sources": {"const": ["src", "tests", "scripts"]}, "config": {"properties": {"path": {"const": "pyproject.toml"}}}, "expected_exit_code": {"const": 1}, "budget": {"const": 266}}}]},
    "lint": {"allOf": [{"$ref": "#/$defs/check"}, {"properties": {"id": {"const": "lint"}, "argv": {"const": ["ruff", "check", "src", "tests", "scripts", "--select", "E4,E7,E9,F", "--output-format", "json"]}, "tool": {"const": "ruff"}, "version": {"const": "0.16.3"}, "sources": {"const": ["src", "tests", "scripts"]}, "config": {"properties": {"path": {"const": "pyproject.toml"}}}, "expected_exit_code": {"const": 1}, "budget": {"const": 832}}}]},
    "type": {"allOf": [{"$ref": "#/$defs/check"}, {"properties": {"id": {"const": "type"}, "argv": {"const": ["mypy", "--no-incremental", "--follow-imports=skip", "src/quarry_recon/report_truth.py", "src/quarry_recon/release_v310_05.py", "src/quarry_recon/release_v310_08.py", "src/quarry_recon/repository_identity.py"]}, "tool": {"const": "mypy"}, "version": {"const": "2.3.1"}, "sources": {"const": ["src/quarry_recon/report_truth.py", "src/quarry_recon/release_v310_05.py", "src/quarry_recon/release_v310_08.py", "src/quarry_recon/repository_identity.py"]}, "config": {"properties": {"path": {"const": "pyproject.toml"}}}, "expected_exit_code": {"const": 0}, "budget": {"const": 0}}}]},
    "docs": {"allOf": [{"$ref": "#/$defs/check"}, {"properties": {"id": {"const": "docs"}, "argv": {"const": ["pytest", "tests/test_docs_parity.py::test_every_config_key_is_documented", "tests/test_docs_parity.py::test_every_target_field_and_mode_is_documented", "tests/test_docs_parity.py::test_every_secret_block_is_documented", "tests/test_docs_parity.py::test_all_relative_doc_links_resolve", "tests/test_docs_parity.py::test_every_command_is_documented_somewhere", "tests/test_docs_parity.py::test_every_entity_is_documented", "tests/test_docs_parity.py::test_every_coverage_kind_is_documented_with_its_class", "tests/test_docs_parity.py::test_all_fenced_yaml_examples_parse", "tests/test_docs_parity.py::test_readme_states_the_current_source_count", "tests/test_docs_parity.py::test_source_registry_has_exact_ownership_and_transport_references", "tests/test_docs_parity.py::test_nuclei_policy_label_is_exact_in_registry_and_generated_docs", "tests/test_docs_parity.py::test_private_reach_default_and_protected_exclusions_are_documented", "tests/test_docs_parity.py::test_oob_public_self_hosted_and_off_transport_are_documented"]}, "tool": {"const": "pytest"}, "version": {"const": "9.1.1"}, "sources": {"const": ["tests/test_docs_parity.py"]}, "config": {"properties": {"path": {"const": "tests/test_docs_parity.py"}}}, "expected_exit_code": {"const": 0}, "budget": {"const": 0}}}]},
    "dead_code": {"allOf": [{"$ref": "#/$defs/check"}, {"properties": {"id": {"const": "dead-code"}, "argv": {"const": ["ruff", "check", "src", "tests", "scripts", "--select", "F401,F841,F811,B018", "--output-format", "json"]}, "tool": {"const": "ruff"}, "version": {"const": "0.16.3"}, "sources": {"const": ["src", "tests", "scripts"]}, "config": {"properties": {"path": {"const": "pyproject.toml"}}}, "expected_exit_code": {"const": 1}, "budget": {"const": 126}}}]},
    "complexity": {"allOf": [{"$ref": "#/$defs/check"}, {"properties": {"id": {"const": "complexity"}, "argv": {"const": ["ruff", "check", "src", "tests", "scripts", "--select", "C90", "--config", "lint.mccabe.max-complexity=50", "--output-format", "json"]}, "tool": {"const": "ruff"}, "version": {"const": "0.16.3"}, "sources": {"const": ["src", "tests", "scripts"]}, "config": {"properties": {"path": {"const": "pyproject.toml"}}}, "expected_exit_code": {"const": 1}, "budget": {"const": 12}}}]}
  }
}
